datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum AccountType {
  CASH
  MOBILE_WALLET
  BANK
  SAVINGS
}

enum WalletRole {
  DAILY_SPENDING
  RESERVE
  SAVINGS_HOLDING
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum IncomeStatus {
  EXPECTED
  RECEIVED
  PARTIAL
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  passwordHash       String
  currency           String              @default("MMK")
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  incomePlans        IncomePlan[]
  savingsGoals       SavingsGoal[]
  savingsAllocations SavingsAllocation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Account {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String              // "Cash", "Kpay", "KBZ Bank", "AYA Bank"
  type               AccountType         @default(CASH)
  role               WalletRole          @default(DAILY_SPENDING)
  color              String?
  icon               String?
  balance            Decimal             @default(0)
  budgetLimit        Decimal?            // Optional monthly spending cap
  transactions       Transaction[]       @relation("TransactionAccount")
  transfersIn        Transaction[]       @relation("TransferDestination")
  savingsAllocations SavingsAllocation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        // "Parent", "Fuel", "Night Snacks", etc.
  type         CategoryType  @default(EXPENSE)
  icon         String?       // Lucide icon identifier
  color        String?       // Hex color or badge theme
  transactions Transaction[]
  budgetItems  BudgetItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account         @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId  String?
  toAccount    Account?        @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type         TransactionType @default(EXPENSE)
  transferTag  String?         // e.g. "CASH_WITHDRAWAL", "FAMILY_EXCHANGE", "TOP_UP", "RESERVE_DRAW", "SAVINGS_CONTRIBUTION"
  amount       Decimal
  date         DateTime        @default(now())
  description  String?
  incomePlanId String?         // Linked if derived from an expected income plan
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model SavingsGoal {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String              // e.g. "Laptop Fund", "General Savings"
  targetAmount Decimal?
  icon         String?             @default("PiggyBank")
  color        String?             @default("#10B981")
  allocations  SavingsAllocation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model SavingsAllocation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount    Decimal     // Positive for deposit/earmark, negative for withdrawal
  note      String?
  date      DateTime    @default(now())
  createdAt DateTime    @default(now())
}

model Budget {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int          // 1 - 12
  year        Int          // e.g. 2026
  totalBudget Decimal      @default(0)
  items       BudgetItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, month, year])
}

model BudgetItem {
  id            String   @id @default(uuid())
  budgetId      String
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  plannedAmount Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([budgetId, categoryId])
}

model IncomePlan {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         String       // "Salary", "Learnex Course", "Investment Return"
  expectedAmount Decimal      @default(0)
  actualAmount   Decimal      @default(0)
  expectedDate   DateTime?
  actualDate     DateTime?
  month          Int          // 1 - 12
  year           Int          // e.g. 2026
  status         IncomeStatus @default(EXPECTED)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
